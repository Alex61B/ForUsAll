<h1>Edit User: <%= @user.full_name %></h1>
<div class="card mt-3">
  <div class="card-body">
    <%= render "shared/errors", object: @user %>
    <%= form_with model: [:admin, @user] do |f| %>
      <div class="mb-3">
        <%= f.label :first_name, class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :last_name, class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :role, class: "form-label" %>
        <%= f.select :role, User.roles.keys.map { |r| [r.capitalize, r] }, {}, class: "form-select" %>
      </div>
      <div class="mb-3">
        <%= f.label :department_id, "Department", class: "form-label" %>
        <%= f.collection_select :department_id, Department.ordered, :id, :name, { include_blank: "— None —" }, class: "form-select" %>
      </div>
      <div class="mb-3">
        <%= f.label :manager_id, "Manager", class: "form-label" %>
        <%= f.collection_select :manager_id, User.where.not(id: @user.id).by_name, :id, :full_name, { include_blank: "— None —" }, class: "form-select" %>
      </div>
      <div class="d-flex gap-2">
        <%= f.submit "Update User", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_user_path(@user), class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
