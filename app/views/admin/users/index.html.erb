<h1>Users</h1>
<table class="table table-hover mt-3">
  <thead>
    <tr><th>Name</th><th>Email</th><th>Role</th><th>Department</th><th>Manager</th><th></th></tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.full_name %></td>
        <td><%= user.email %></td>
        <td><span class="badge bg-secondary"><%= user.role %></span></td>
        <td><%= user.department&.name || "—" %></td>
        <td><%= user.manager&.full_name || "—" %></td>
        <td>
          <%= link_to "View", admin_user_path(user), class: "btn btn-sm btn-outline-primary" %>
          <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
