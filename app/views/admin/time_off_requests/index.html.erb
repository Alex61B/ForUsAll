<h1>All Time Off Requests</h1>

<form class="row g-2 mb-3" method="get" action="<%= admin_time_off_requests_path %>">
  <div class="col-auto">
    <select name="user_id" class="form-select form-select-sm">
      <option value="">All Employees</option>
      <% @users.each do |u| %>
        <option value="<%= u.id %>" <%= "selected" if params[:user_id] == u.id.to_s %>><%= u.full_name %></option>
      <% end %>
    </select>
  </div>
  <div class="col-auto">
    <select name="status" class="form-select form-select-sm">
      <option value="">All Statuses</option>
      <% TimeOffRequest.statuses.keys.each do |s| %>
        <option value="<%= s %>" <%= "selected" if params[:status] == s %>><%= s.capitalize %></option>
      <% end %>
    </select>
  </div>
  <div class="col-auto">
    <select name="leave_type" class="form-select form-select-sm">
      <option value="">All Types</option>
      <% TimeOffRequest.leave_types.keys.each do |t| %>
        <option value="<%= t %>" <%= "selected" if params[:leave_type] == t %>><%= t.humanize %></option>
      <% end %>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    <%= link_to "Clear", admin_time_off_requests_path, class: "btn btn-sm btn-outline-danger" %>
  </div>
</form>

<% if @requests.any? %>
  <table class="table table-hover">
    <thead>
      <tr><th>Employee</th><th>Type</th><th>Dates</th><th>Status</th><th>Reviewed By</th></tr>
    </thead>
    <tbody>
      <% @requests.each do |req| %>
        <tr>
          <td><%= link_to req.user.full_name, admin_user_path(req.user) %></td>
          <td><%= req.leave_type.humanize %></td>
          <td><%= req.start_date %> – <%= req.end_date %></td>
          <td>
            <% badge_class = { "pending" => "bg-warning text-dark", "approved" => "bg-success", "denied" => "bg-danger", "cancelled" => "bg-secondary" }.fetch(req.status, "bg-secondary") %>
            <span class="badge <%= badge_class %>"><%= req.status.capitalize %></span>
          </td>
          <td><%= req.reviewed_by&.full_name || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= paginate @requests %>
<% else %>
  <p class="text-muted mt-3">No requests match the selected filters.</p>
<% end %>
