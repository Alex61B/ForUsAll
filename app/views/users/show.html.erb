<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>My Profile</h1>
  <%= link_to "Edit Profile", edit_profile_path, class: "btn btn-outline-primary" %>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Name</dt>
      <dd class="col-sm-9"><%= @user.full_name %></dd>
      <dt class="col-sm-3">Email</dt>
      <dd class="col-sm-9"><%= @user.email %></dd>
      <dt class="col-sm-3">Role</dt>
      <dd class="col-sm-9"><span class="badge bg-secondary"><%= @user.role.capitalize %></span></dd>
      <dt class="col-sm-3">Department</dt>
      <dd class="col-sm-9"><%= @user.department&.name || "—" %></dd>
      <dt class="col-sm-3">Manager</dt>
      <dd class="col-sm-9"><%= @user.manager&.full_name || "—" %></dd>
    </dl>
  </div>
</div>
