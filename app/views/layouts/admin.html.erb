<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Admin — Time Off Tracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <%= stylesheet_link_tag :app %>
  </head>
  <body>
    <%= render "shared/navbar" %>
    <div class="container-fluid mt-4">
      <div class="row">
        <nav class="col-md-2">
          <div class="list-group">
            <%= link_to "Dashboard", dashboard_path, class: "list-group-item list-group-item-action" %>
            <%= link_to "Users", admin_users_path, class: "list-group-item list-group-item-action" %>
            <%= link_to "Departments", admin_departments_path, class: "list-group-item list-group-item-action" %>
            <%= link_to "All Requests", admin_time_off_requests_path, class: "list-group-item list-group-item-action" %>
          </div>
        </nav>
        <main class="col-md-10">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
