<% if object.errors.any? %>
  <div class="alert alert-danger">
    <strong><%= pluralize(object.errors.count, "error") %> prevented this from being saved:</strong>
    <ul class="mb-0 mt-1">
      <% object.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
