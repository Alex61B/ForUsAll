<h1>Dashboard</h1>
<p class="text-muted">Welcome, <%= current_user.full_name %>!</p>

<div class="row mt-3">
  <div class="col-md-4">
    <div class="card text-white bg-warning mb-3">
      <div class="card-body text-center">
        <h3><%= @pending_count %></h3>
        <p class="mb-0">Pending Requests</p>
      </div>
    </div>
  </div>
</div>

<h4 class="mt-4">Recent Requests</h4>
<% if @recent_requests.any? %>
  <table class="table table-hover">
    <thead>
      <tr>
        <th>Employee</th>
        <th>Type</th>
        <th>Dates</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @recent_requests.each do |req| %>
        <%= render "time_off_requests/request_row", tor: req %>
      <% end %>
    </tbody>
  </table>
  <%= link_to "View All Requests", time_off_requests_path, class: "btn btn-outline-primary" %>
<% else %>
  <p class="text-muted">No requests yet.</p>
  <%= link_to "Submit a Request", new_time_off_request_path, class: "btn btn-primary" %>
<% end %>
