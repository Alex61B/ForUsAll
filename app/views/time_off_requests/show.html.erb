<div class="d-flex justify-content-between align-items-start mb-4">
  <h1>Time Off Request</h1>
  <%= link_to "Back", time_off_requests_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Employee</dt>
      <dd class="col-sm-9"><%= @request.user.full_name %></dd>
      <dt class="col-sm-3">Type</dt>
      <dd class="col-sm-9"><%= @request.leave_type.humanize %></dd>
      <dt class="col-sm-3">Dates</dt>
      <dd class="col-sm-9"><%= @request.start_date.strftime("%B %d, %Y") %> – <%= @request.end_date.strftime("%B %d, %Y") %> (<%= @request.duration_days %> days)</dd>
      <dt class="col-sm-3">Status</dt>
      <dd class="col-sm-9">
        <% badge_class = { "pending" => "warning text-dark", "approved" => "success", "denied" => "danger", "cancelled" => "secondary" }[@request.status] %>
        <span class="badge bg-<%= badge_class %>"><%= @request.status.capitalize %></span>
      </dd>
      <dt class="col-sm-3">Reason</dt>
      <dd class="col-sm-9"><%= @request.reason.presence || "—" %></dd>
      <% if @request.reviewed_by %>
        <dt class="col-sm-3">Reviewed By</dt>
        <dd class="col-sm-9"><%= @request.reviewed_by.full_name %> on <%= @request.reviewed_at.strftime("%B %d, %Y") %></dd>
      <% end %>
    </dl>
  </div>
</div>

<div class="d-flex gap-2">
  <% if policy(@request).approve? %>
    <%= button_to "Approve", approve_time_off_request_path(@request), method: :patch, class: "btn btn-success" %>
  <% end %>
  <% if policy(@request).deny? %>
    <%= button_to "Deny", deny_time_off_request_path(@request), method: :patch, class: "btn btn-danger" %>
  <% end %>
  <% if policy(@request).cancel? %>
    <%= button_to "Cancel Request", cancel_time_off_request_path(@request), method: :patch, class: "btn btn-warning",
        data: { confirm: "Are you sure you want to cancel this request?" } %>
  <% end %>
</div>
