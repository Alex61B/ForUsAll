<%= render "shared/errors", object: request %>

<%= form_with model: request, class: "mt-3" do |f| %>
  <div class="mb-3">
    <%= f.label :leave_type, "Leave Type", class: "form-label" %>
    <%= f.select :leave_type, TimeOffRequest.leave_types.keys.map { |t| [t.humanize, t] },
                 { include_blank: "Select type" }, class: "form-select" %>
  </div>
  <div class="row mb-3">
    <div class="col">
      <%= f.label :start_date, "Start Date", class: "form-label" %>
      <%= f.date_field :start_date, class: "form-control", min: Date.today %>
    </div>
    <div class="col">
      <%= f.label :end_date, "End Date", class: "form-label" %>
      <%= f.date_field :end_date, class: "form-control", min: Date.today %>
    </div>
  </div>
  <div class="mb-3">
    <%= f.label :reason, class: "form-label" %>
    <%= f.text_area :reason, rows: 3, class: "form-control", placeholder: "Optional reason..." %>
  </div>
  <div class="d-flex gap-2">
    <%= f.submit "Submit Request", class: "btn btn-primary" %>
    <%= link_to "Cancel", time_off_requests_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
