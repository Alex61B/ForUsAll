<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Time Off Requests</h1>
  <%= link_to "New Request", new_time_off_request_path, class: "btn btn-primary" %>
</div>

<form class="row g-2 mb-3" method="get">
  <div class="col-auto">
    <select name="status" class="form-select form-select-sm">
      <option value="">All Statuses</option>
      <% TimeOffRequest.statuses.keys.each do |s| %>
        <option value="<%= s %>" <%= "selected" if params[:status] == s %>><%= s.capitalize %></option>
      <% end %>
    </select>
  </div>
  <div class="col-auto">
    <select name="leave_type" class="form-select form-select-sm">
      <option value="">All Types</option>
      <% TimeOffRequest.leave_types.keys.each do |t| %>
        <option value="<%= t %>" <%= "selected" if params[:leave_type] == t %>><%= t.humanize %></option>
      <% end %>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
  </div>
</form>

<% if @requests.any? %>
  <table class="table table-hover">
    <thead>
      <tr>
        <th>Employee</th><th>Type</th><th>Dates</th><th>Status</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% @requests.each do |req| %>
        <%= render "request_row", tor: req %>
      <% end %>
    </tbody>
  </table>
  <%= paginate @requests %>
<% else %>
  <p class="text-muted">No requests found.</p>
<% end %>
